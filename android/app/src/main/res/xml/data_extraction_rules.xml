<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules.
     Excludes the WebView's localStorage (which holds API keys) from
     any backup, device-transfer, or cloud-sync extraction. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
